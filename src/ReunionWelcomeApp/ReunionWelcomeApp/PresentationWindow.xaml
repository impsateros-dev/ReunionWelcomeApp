<Window x:Class="ReunionWelcomeApp.PresentationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reunion Presentation" 
        WindowState="Maximized" 
        WindowStyle="None"
        SizeChanged="Window_SizeChanged"
        Background="#EEEDF2">
    <Grid>
        <!-- Semi-transparent overlay for better name visibility -->
        <Grid.Background>
            <SolidColorBrush Color="#EEEDF2"/>
        </Grid.Background>

        <!-- Logo at top center -->
        <Image x:Name="LogoImage" 
               Source="Resources/Images/Impsat-FondoBlanco.jpg" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Margin="0,30,0,0"
               Width="500"
               Opacity="0.5"/>

        <!-- Main content area -->
        <Grid>
            <!-- Current name display (animated) -->
            <Border x:Name="CurrentNameBorder"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#E0E0E0"
                    CornerRadius="20"
                    Padding="60,30"
                    Visibility="{Binding ShowCurrentName, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CurrentName}"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="#003399"
                           FontFamily="Segoe UI"
                           Opacity="{Binding CurrentNameOpacity}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Border>

            <!-- Name Cloud Canvas -->
            <Canvas x:Name="NameCloudCanvas" ClipToBounds="True"/>
        </Grid>

        <!-- Attendee counter at bottom right -->
        <Border VerticalAlignment="Bottom" 
                HorizontalAlignment="Right" 
                Background="#30ffffff" 
                CornerRadius="10" 
                Padding="20,10" 
                Margin="30">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Asistentes: " 
                           FontSize="24" 
                           Foreground="{Binding CounterColorBrush}"
                           FontFamily="Segoe UI"/>
                <TextBlock Text="{Binding AttendeeCount}" 
                           FontSize="24" 
                           Foreground="{Binding CounterColorBrush}" 
                           FontWeight="Bold"
                           FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Debug overlay (F1) -->
        <Border Visibility="{Binding IsDebugVisible, Converter={StaticResource BoolToVisibility}}"
                Background="#CC000000"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Padding="10"
                Margin="10">
            <StackPanel>
                <TextBlock Foreground="Lime" FontFamily="Consolas" FontSize="12">
                    <Run Text="DEBUG MODE"/>
                    <LineBreak/>
                    <Run Text="{Binding AttendeeCount, StringFormat='Attendees: {0}'}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>